# 学习通账号（Cookie 失效时自动填写登录）
XXT_PHONE=你的手机号
XXT_PASSWORD=你的密码

# 课程页面链接（在学习通网页端打开课程 → 复制地址栏 URL）
XXT_COURSE_URL=https://mooc1.chaoxing.com/mycourse/studentstudy?chapterId=xxx&courseId=xxx&clazzid=xxx&cpi=xxx&enc=xxx&mooc2=1&hidetype=0&openc=xxx

# Tesseract OCR 路径（可选，默认 D:\Tesseract_OCR\tesseract.exe）
# TESSERACT_CMD=D:\Tesseract_OCR\tesseract.exe
